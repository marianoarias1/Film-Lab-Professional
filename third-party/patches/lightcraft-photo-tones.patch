+/// Smooth shadow/highlight adjustment in stops. The derivative of base+delta is
+/// >= 0.35 for every supported pair of controls: no reversal of a luminance ramp.
+/// Operates on the existing edge-aware base, not independently on RGB channels.
+pub fn photo_tone_delta(base: f32, highlights: f32, shadows: f32) -> f32 {
+    fn softplus(x: f32) -> f32 {
+        if x > 16.0 { x } else if x < -16.0 { x.exp2() / std::f32::consts::LN_2 } else { (1.0 + x.exp2()).log2() }
+    }
+    0.65 * (highlights.clamp(-1.0, 1.0) * softplus(base - 0.5)
+        + shadows.clamp(-1.0, 1.0) * softplus(-base - 1.0))
+}
+
+/// sRGB gamut projection at constant OkLab lightness and hue, reducing chroma
+/// only when necessary. Already representable colours pass through untouched.
+/// Search is bounded to 14 steps and runs only for out-of-gamut pixels.
+/// No claim is made to retain both chroma and luminance at a gamut boundary.
+pub fn photo_gamut_srgb(rgb: [f32; 3]) -> ([f32; 3], f32) {
+    use lightcraft_color::{SRGB, REC2020, Mat3};
+    use lightcraft_color::perceptual::{oklab_from_2020, oklab_to_2020};
+    use std::sync::OnceLock;
+    if rgb.iter().all(|c| (0.0..=1.0).contains(c)) { return (rgb, 1.0); }
+    if rgb.iter().any(|c| !c.is_finite()) { return ([0.0; 3], 0.0); }
+    static MATRICES: OnceLock<(Mat3, Mat3)> = OnceLock::new();
+    let (to_work, to_srgb) = MATRICES.get_or_init(|| (SRGB.to_space(&REC2020), REC2020.to_space(&SRGB)));
+    let lab = oklab_from_2020(to_work.apply_f32(rgb));
+    let light = lab[0].clamp(0.0, 1.0);
+    if light <= 1e-6 { return ([0.0; 3], 0.0); }
+    if light >= 1.0 - 1e-6 { return ([1.0; 3], 0.0); }
+    let candidate = |scale| to_srgb.apply_f32(oklab_to_2020([light, lab[1]*scale, lab[2]*scale]));
+    let (mut low, mut high) = (0.0, 1.0);
+    for _ in 0..14 {
+        let mid = (low + high) * 0.5;
+        if candidate(mid).iter().all(|c| *c >= 0.0 && *c <= 1.0) { low = mid; } else { high = mid; }
+    }
+    // This clamp addresses roundoff at the neutral endpoints, not RGB clipping
+    // as a substitute for the chroma search. A neutral is always the fallback.
+    (candidate(low).map(|c| c.clamp(0.0, 1.0)), low)
+}
